{
  "name": "nuclear-harbor",
  "version": "0.1.0",
  "private": true,
  "description": "Last Stand: Nuclear Harbor - browser FPS (Three.js + TypeScript + Vite)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "e2e": "node scripts/e2e.mjs",
    "bench": "node scripts/bench.mjs",
    "leakcheck": "node scripts/leakcheck.mjs",
    "offline": "node scripts/offline.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
